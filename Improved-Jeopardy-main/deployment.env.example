# Copy to a PRIVATE environment file or enter in your hosting dashboard.
# Do not put real credentials in this example or commit your private copy.
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
APP_URL=https://your-app.example
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MS_ENTRA_TENANT_ID=your-tenant-id
MS_ENTRA_CLIENT_ID=your-client-id
MS_ENTRA_CLIENT_SECRET=your-client-secret
MS_ENTRA_REDIRECT_URI=https://your-app.example/api/auth/callback
# Atlas Free connection string. Keep the real URI private and server-side.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=jeopardy
# Scratch path only when MongoDB is configured; no paid disk required.
JEOPARDY_DATA_DIR=/data
# Use 1 only when there is exactly one trusted reverse proxy in front of Node.
TRUST_PROXY=1
